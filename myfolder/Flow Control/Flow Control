Loop Flow Control

code
public class Program002_LoopFlow {
    public static void main(String[] args) {
        System.out.println("Printing odd numbers up to 10, skipping 5:");
        for (int i = 1; i <= 10; i++) {
            if (i % 2 == 0) continue; // Skip even numbers
            if (i == 7) break;       // Terminate early at 7
            System.out.print(i + " ");
        }
    }
}

