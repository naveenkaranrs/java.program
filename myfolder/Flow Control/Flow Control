Early Exit Flow (return inside loops)
code
public class Program004_EarlyExitFlow {
    static boolean containsKey(int[] arr, int target) {
        for (int num : arr) {
            if (num == target) return true; // Early return exit flow
        }
        return false;
    }
    public static void main(String[] args) {
        int[] numbers = {10, 25, 40, 55};
        System.out.println("Found 25: " + containsKey(numbers, 25));
    }
}
