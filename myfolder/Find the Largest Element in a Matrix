Find the Largest Element in a Matrix

public class Main {
    public static void main(String[] args) {
        int[][] matrix = {
            {12, 45, 67},
            {89, 23, 34},
            {56, 78, 90}
        };

        int max = matrix[0][0];
        for (int i = 0; i < matrix.length; i++) {
            for (int j = 0; j < matrix[i].length; j++) {
                if (matrix[i][j] > max) {
                    max = matrix[i][j];
                }
            }
        }

        System.out.println("Largest element: " + max);
    }
}

output: Largest element: 90
